{
  "name": "@todde.tv/stage-flow-tools",
  "version": "1.0.0-rc.0",
  "description": "Real-time quiz and interaction tool for live presentations. Features include admin-controlled quiz flow, live results, and instant audience participation. Boost engagement on stage - at conferences, sessions, and workshops.",
  "license": "Apache-2.0",
  "author": "Thorsten Seyschab <hello@todde.tv> (https://todde.tv/)",
  "contributors": [
    "Thorsten Seyschab <hello@todde.tv> (https://todde.tv/)"
  ],
  "homepage": "https://todde.tv/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toddeTV/stage-flow-tools.git"
  },
  "bugs": {
    "url": "https://github.com/toddeTV/stage-flow-tools/issues"
  },
  "type": "module",
  "scripts": {
    "build:ssg": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nuxt generate",
    "build:ssr": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nuxt build",
    "dev": "nuxt dev",
    "dev:preset": "nuxt dev --port 3000 --public",
    "drizzle:migrate:apply:dev": "vp exec drizzle-kit migrate --config=drizzle.config.dev.ts",
    "drizzle:migrate:apply:prod": "vp exec drizzle-kit migrate --config=drizzle.config.prod.ts",
    "drizzle:migrate:create": "vp exec drizzle-kit generate --config=drizzle.config.ts",
    "drizzle:studio:dev": "vp exec drizzle-kit studio --config=drizzle.config.dev.ts",
    "drizzle:studio:prod": "vp exec drizzle-kit studio --config=drizzle.config.prod.ts",
    "fix": "vp run fix:lint-format && vp run fix:package-json",
    "fix:lint-format": "vp exec eslint . --fix",
    "fix:package-json": "vp exec prettier-package-json --write package.json",
    "hooks:install": "vp run hooks:install:vite-plus && vp run notices:hook:install",
    "hooks:install:vite-plus": "vp config --hooks-only",
    "postinstall": "nuxt prepare",
    "install:clean": "vp install --prefer-offline",
    "install:clean:frozen": "vp install --frozen-lockfile --prefer-offline",
    "notices:generate": "vp exec tsx scripts/write-third-party-notices.ts",
    "notices:hook:install": "vp exec tsx scripts/install-third-party-notices-hook.ts install",
    "notices:hook:status": "vp exec tsx scripts/install-third-party-notices-hook.ts status",
    "notices:validate": "vp exec tsx scripts/write-third-party-notices.ts --check",
    "ops:seed:dev": "vp exec tsx scripts/ops-seed.ts --target dev",
    "prepare": "vp run hooks:install",
    "preview:ssg": "vp dlx serve .output/public",
    "preview:ssr": "nuxt preview",
    "test": "concurrently --names \"test:lint-format,test:package-json,test:notices,test:type,test:unit\" \"vp exec eslint .\" \"vp exec prettier-package-json --list-different package.json\" \"vp run test:notices\" \"nuxt typecheck\" \"vp test run app server shared scripts\"",
    "test:lint-format": "vp exec eslint .",
    "test:notices": "vp run notices:validate",
    "test:package-json": "vp exec prettier-package-json --list-different package.json",
    "test:type": "nuxt typecheck",
    "test:unit": "vp test run app server shared scripts"
  },
  "dependencies": {
    "nuxt": "~4.5.2",
    "vue": "~3.5.42"
  },
  "devDependencies": {
    "@eslint/css": "~1.4.0",
    "@eslint/js": "~10.0.1",
    "@nuxt/eslint": "~1.17.0",
    "@nuxtjs/i18n": "~10.6.0",
    "@paralleldrive/cuid2": "~3.3.0",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@tailwindcss/vite": "~4.3.3",
    "@types/better-sqlite3": "~9.6.0",
    "@vueuse/core": "~14.4.0",
    "@vueuse/nuxt": "~14.4.0",
    "better-sqlite3": "~13.0.3",
    "concurrently": "~10.0.5",
    "cross-env": "~10.1.0",
    "crossws": "0.3.5",
    "drizzle-kit": "~0.31.10",
    "drizzle-orm": "~0.45.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "~4.7.0",
    "eslint-plugin-format": "~2.0.1",
    "eslint-plugin-jsonc": "~3.4.2",
    "eslint-plugin-perfectionist": "~5.11.0",
    "eslint-plugin-yml": "~3.8.1",
    "jose": "~6.2.10",
    "nuxi": "~3.37.0",
    "prettier": "~3.9.6",
    "prettier-package-json": "~2.8.0",
    "tailwind-csstree": "~0.3.3",
    "tailwindcss": "~4.3.3",
    "tsx": "~4.23.13",
    "typescript": "~6.0.3",
    "vite-plus": "catalog:",
    "vue-tsc": "~3.3.11"
  },
  "keywords": [
    "audience-participation",
    "conference-tool",
    "educational",
    "engagement",
    "interactive",
    "live-interaction",
    "presentation-tool",
    "presenter",
    "quiz",
    "results-display",
    "stage-flow",
    "voting",
    "web-app",
    "workshop"
  ],
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "packageManager": "pnpm@10.33.0"
}
